{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Jellyfin Merge Proxy",
  "uid": "jellyfin-merge-proxy",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "jellyfin",
    "jmp"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/s by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(jmp_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(jmp_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(jmp_http_errors_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Stage p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(jmp_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Upstream up",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jmp_upstream_up",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Upstream p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, server) (rate(jmp_upstream_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Upstream requests by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server, status_class) (rate(jmp_upstream_requests_total[5m]))",
          "legendFormat": "{{server}} {{status_class}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Upstream errors / reauth",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server, kind) (rate(jmp_upstream_errors_total[5m]))",
          "legendFormat": "{{server}} {{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum by (server) (rate(jmp_upstream_reauth_total[5m]))",
          "legendFormat": "{{server}} reauth"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Fan-out outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server, outcome) (rate(jmp_fanout_upstream_results_total[5m]))",
          "legendFormat": "{{server}} {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(jmp_fanout_partial_total[5m]))",
          "legendFormat": "partial"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dedupe dropped by key",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (key) (rate(jmp_dedupe_dropped_total[5m]))",
          "legendFormat": "{{key}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Active streams",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server, kind) (jmp_streams_active)",
          "legendFormat": "{{server}} {{kind}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Stream throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(jmp_stream_bytes_total[5m]))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Stream TTFB p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, server) (rate(jmp_stream_ttfb_seconds_bucket[5m])))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Stream endings",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(jmp_stream_end_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Logins / sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(jmp_logins_total[5m]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "jmp_sessions_active",
          "legendFormat": "active sessions"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "ID table size",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jmp_ids_table_size",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jmp_cache_requests_total{outcome=\"hit\"}[5m])) / sum(rate(jmp_cache_requests_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Config reloads",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(jmp_config_reloads_total[1h]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "jmp_config_generation",
          "legendFormat": "generation"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "TLS cert days left",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(jmp_tls_cert_expiry_timestamp_seconds - time()) / 86400",
          "legendFormat": "{{cert}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Process",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total[5m])",
          "legendFormat": "cpu"
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes / 1e6",
          "legendFormat": "RSS MB"
        },
        {
          "refId": "C",
          "expr": "jmp_tokio_alive_tasks",
          "legendFormat": "tokio tasks"
        }
      ]
    }
  ]
}